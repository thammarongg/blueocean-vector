# Embedding provider: fastembed (default), openai, bedrock
BLUEOCEAN_EMBEDDING=fastembed

# FastEmbed model (multilingual: Thai + English). Pin the version so local and
# cloud deployments produce compatible vectors.
BLUEOCEAN_EMBED_MODEL=intfloat/multilingual-e5-large

# Optional: local cache dir for the downloaded model weights
# BLUEOCEAN_EMBED_CACHE_DIR=~/.cache/blueocean

# Qdrant connection
BLUEOCEAN_QDRANT_URL=http://localhost:6333
# BLUEOCEAN_QDRANT_API_KEY=

# Transport is a CLI flag, not an env var, since it's a "how do I run this"
# choice: `blueocean-mcp --transport streamable-http --host 0.0.0.0 --port 8765`
# (recommended: one shared server registered by URL) or
# `blueocean-mcp --transport stdio` (default: spawned per-agent).

# Bearer token required on every streamable-http request. Unset = no auth
# (fine for 127.0.0.1-only local use; required if exposed beyond localhost).
# Generate one with: uv run blueocean-admin generate-token --write-env
# BLUEOCEAN_AUTH_TOKEN=

# Default search budget
BLUEOCEAN_MAX_TOKENS=2000
BLUEOCEAN_TOP_K=20

# HNSW index tuning for large (XL) project collections
BLUEOCEAN_HNSW_M=16
BLUEOCEAN_HNSW_EF_CONSTRUCT=100

# OpenAI provider (optional)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Bedrock provider (optional)
# AWS_REGION=us-east-1
# BLUEOCEAN_BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0